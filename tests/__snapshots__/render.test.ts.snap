exports[`render > stage egg 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="480" height="120" viewBox="0 0 480 120" role="img" aria-label="lma0/shell-pet: Egg hermit crab, happy"><title>lma0/shell-pet: Egg hermit crab, happy</title><style>.sp-bg{fill:#FAF7F2}.sp-bd{stroke:#E8DFD2}.sp-t1{fill:#2B1D1A}.sp-t2{fill:#5B4A44}.sp-bob{animation:sp-bob 3s ease-in-out infinite}@keyframes sp-bob{50%{transform:translateY(-3px)}}.sp-blink{transform-box:fill-box;transform-origin:center;animation:sp-blink 5s infinite}@keyframes sp-blink{0%,93%,100%{transform:scaleY(1)}96%{transform:scaleY(.1)}}.sp-jump{animation:sp-jump 1.1s ease-in-out infinite}@keyframes sp-jump{0%,100%{transform:translateY(0)}45%{transform:translateY(-16px)}}.sp-shadow{transform-box:fill-box;transform-origin:center;animation:sp-shadow 1.1s ease-in-out infinite}@keyframes sp-shadow{45%{transform:scale(.7);opacity:.5}}.sp-fall{animation:sp-fall 2.6s linear infinite}@keyframes sp-fall{0%{transform:translateY(-8px) rotate(0);opacity:0}15%{opacity:1}100%{transform:translateY(44px) rotate(160deg);opacity:0}}.sp-z{animation:sp-z 3.6s ease-in infinite}@keyframes sp-z{0%{transform:translate(0,0);opacity:0}25%{opacity:1}100%{transform:translate(10px,-22px);opacity:0}}.sp-twinkle{transform-box:fill-box;transform-origin:center;animation:sp-twinkle 2.1s ease-in-out infinite}@keyframes sp-twinkle{50%{transform:scale(.45);opacity:.45}}.sp-drift{animation:sp-drift 9s ease-in-out infinite alternate}.sp-drift2{animation:sp-drift 7s ease-in-out infinite alternate-reverse}@keyframes sp-drift{to{transform:translateX(-30px)}}.sp-cursor{animation:sp-cursor 1.1s steps(1) infinite}@keyframes sp-cursor{50%{opacity:0}}.sp-steam{animation:sp-steam 3s ease-in-out infinite}@keyframes sp-steam{0%{transform:translateY(4px);opacity:0}40%{opacity:1}100%{transform:translateY(-8px);opacity:0}}@media (prefers-reduced-motion:reduce){*{animation:none!important}}</style><defs><filter id="sp-fade"><feColorMatrix type="saturate" values="0.3"/></filter><filter id="sp-lonely"><feColorMatrix type="saturate" values="0.5"/></filter></defs><rect class="sp-bg" width="480" height="120" rx="12"/><defs><clipPath id="sp-scene"><path d="M12 0H264V120H12A12 12 0 0 1 0 108V12A12 12 0 0 1 12 0Z"/></clipPath></defs><g clip-path="url(#sp-scene)"><g class="sp-drift"><path d="M-60 62Q-30 53 0 62Q30 53 60 62Q90 53 120 62Q150 53 180 62Q210 53 240 62Q270 53 300 62Q330 53 360 62V100H-60Z" fill="#A6D6F3"/></g><g class="sp-drift2"><path d="M-60 74Q-30 66 0 74Q30 66 60 74Q90 66 120 74Q150 66 180 74Q210 66 240 74Q270 66 300 74Q330 66 360 74V104H-60Z" fill="#5DAEE3"/></g><path d="M-2 92Q70 82 140 89T268 86V122H-2Z" fill="#F3DFBD"/><g fill="#E1C597"><circle cx="34" cy="108" r="2"/><circle cx="58" cy="114" r="1.6"/><circle cx="190" cy="112" r="2"/><circle cx="236" cy="104" r="1.6"/><circle cx="220" cy="116" r="1.4"/><circle cx="16" cy="98" r="1.4"/></g></g><g transform="translate(48 -8) scale(.79)"><ellipse cx="114" cy="151" rx="50" ry="8" fill="#EFD9B0"/><g class="sp-bob"><path d="M112 84C134 84 142 112 140 127C138 143 126 151 112 151C98 151 86 143 84 127C82 112 90 84 112 84Z" fill="#FBF3E6" stroke="#2B1D1A" stroke-width="4.5"/><g fill="#E2BC92"><ellipse cx="101" cy="104" rx="5" ry="4"/><circle cx="123" cy="98" r="3"/><ellipse cx="127" cy="126" rx="5.5" ry="4.5"/><circle cx="99" cy="134" r="3.5"/><circle cx="114" cy="118" r="2.5"/></g></g></g><g font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"><text class="sp-t1" x="284" y="46" font-size="19" font-weight="700">lma0/shell-pet</text><text class="sp-t2" x="284" y="68" font-size="12.5">Stage: Egg · Mood: Happy</text><path transform="translate(291 87.5)" d="M0 -7.5L2.1 -2.9L7.1 -2.3L3.4 1.1L4.4 6.1L0 3.6L-4.4 6.1L-3.4 1.1L-7.1 -2.3L-2.1 -2.9Z" fill="#F6C343"/><text class="sp-t2" x="303" y="92" font-size="12.5">star to feed me</text></g><rect class="sp-bd" x=".75" y=".75" width="478.5" height="118.5" rx="11.25" fill="none" stroke-width="1.5"/></svg>"`;

