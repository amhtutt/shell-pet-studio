exports[`render > language shell 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="-6 -26 236 236" role="img" aria-label="lma0/shell-pet: Adult hermit crab, happy"><title>lma0/shell-pet: Adult hermit crab, happy</title><style>.sp-bg{fill:#FAF7F2}.sp-bd{stroke:#E8DFD2}.sp-t1{fill:#2B1D1A}.sp-t2{fill:#5B4A44}@media (prefers-color-scheme:dark){.sp-bg{fill:#16202E}.sp-bd{stroke:#2A3A50}.sp-t1{fill:#E8EDF5}.sp-t2{fill:#B6C2D3}}.sp-bob{animation:sp-bob 3s ease-in-out infinite}@keyframes sp-bob{50%{transform:translateY(-3px)}}.sp-blink{transform-box:fill-box;transform-origin:center;animation:sp-blink 5s infinite}@keyframes sp-blink{0%,93%,100%{transform:scaleY(1)}96%{transform:scaleY(.1)}}.sp-jump{animation:sp-jump 1.1s ease-in-out infinite}@keyframes sp-jump{0%,100%{transform:translateY(0)}45%{transform:translateY(-16px)}}.sp-shadow{transform-box:fill-box;transform-origin:center;animation:sp-shadow 1.1s ease-in-out infinite}@keyframes sp-shadow{45%{transform:scale(.7);opacity:.5}}.sp-fall{animation:sp-fall 2.6s linear infinite}@keyframes sp-fall{0%{transform:translateY(-8px) rotate(0);opacity:0}15%{opacity:1}100%{transform:translateY(44px) rotate(160deg);opacity:0}}.sp-z{animation:sp-z 3.6s ease-in infinite}@keyframes sp-z{0%{transform:translate(0,0);opacity:0}25%{opacity:1}100%{transform:translate(10px,-22px);opacity:0}}.sp-twinkle{transform-box:fill-box;transform-origin:center;animation:sp-twinkle 2.1s ease-in-out infinite}@keyframes sp-twinkle{50%{transform:scale(.45);opacity:.45}}.sp-drift{animation:sp-drift 9s ease-in-out infinite alternate}.sp-drift2{animation:sp-drift 7s ease-in-out infinite alternate-reverse}@keyframes sp-drift{to{transform:translateX(-30px)}}.sp-cursor{animation:sp-cursor 1.1s steps(1) infinite}@keyframes sp-cursor{50%{opacity:0}}.sp-steam{animation:sp-steam 3s ease-in-out infinite}@keyframes sp-steam{0%{transform:translateY(4px);opacity:0}40%{opacity:1}100%{transform:translateY(-8px);opacity:0}}@media (prefers-reduced-motion:reduce){*{animation:none!important}}</style><defs><filter id="sp-fade"><feColorMatrix type="saturate" values="0.3"/></filter><filter id="sp-lonely"><feColorMatrix type="saturate" values="0.5"/></filter></defs><g class="sp-bob"><g transform="translate(142 150) scale(1) translate(-142 -150)"><path d="M103.5 130Q95.5 144 92 150Q108.5 136 120.5 130Z" fill="#E3844E" stroke="#2B1D1A" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/><path d="M115.5 138Q110.7 148.5 112 153Q125.3 142.5 132.5 138Z" fill="#E3844E" stroke="#2B1D1A" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/><path d="M139.5 141Q141.1 149.4 152 153Q158.9 144.6 156.5 141Z" fill="#F8A06A" stroke="#2B1D1A" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/><path d="M154.5 137Q160.9 147.5 179 152Q181.1 141.5 171.5 137Z" fill="#F8A06A" stroke="#2B1D1A" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/><g transform="translate(192 102) rotate(-24) scale(0.672)"><ellipse rx="18" ry="15" fill="#E3844E" stroke="#2B1D1A" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/><path d="M-3 -3Q9 -3 16 6" fill="none" stroke="#2B1D1A" stroke-width="3.2" stroke-linecap="round"/></g><path d="M150 96L154 58" stroke="#2B1D1A" stroke-width="13" stroke-linecap="round"/><path d="M150 96L154 58" stroke="#F8A06A" stroke-width="5" stroke-linecap="round"/><path d="M163 99L178 65" stroke="#2B1D1A" stroke-width="13" stroke-linecap="round"/><path d="M163 99L178 65" stroke="#F8A06A" stroke-width="5" stroke-linecap="round"/><defs><clipPath id="sp-body"><ellipse cx="142" cy="116" rx="38" ry="29"/></clipPath></defs><ellipse cx="142" cy="116" rx="38" ry="29" fill="#F8A06A"/><g clip-path="url(#sp-body)"><ellipse cx="142" cy="136" rx="44" ry="12" fill="#E3844E"/><path d="M141 90Q149 116 141 146M151 92Q159 118 151 146" fill="none" stroke="#E3844E" stroke-width="4"/></g><ellipse cx="142" cy="116" rx="38" ry="29" fill="none" stroke="#2B1D1A" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/><circle cx="160" cy="105" r="5.5" fill="#F7A9A0"/><path d="M161 108Q166 114 171 108" fill="none" stroke="#2B1D1A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><g transform="translate(128 130) scale(0.922)"><rect x="-98" y="-88" width="104" height="92" rx="16" fill="#3B3F46" stroke="#2B1D1A" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/><path d="M-98 -20L6 -20L6 -12Q6 4 -10 4L-82 4Q-98 4 -98 -12Z" fill="#2E3238"/><rect x="-98" y="-88" width="104" height="92" rx="16" fill="none" stroke="#2B1D1A" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/><rect x="-80" y="-74" width="74" height="50" rx="7" fill="#14171B" stroke="#1B1E22" stroke-width="2"/><path d="M-72 -62L-64 -55L-72 -48" fill="none" stroke="#3DDC6E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><g class="sp-cursor"><rect x="-58" y="-62" width="8" height="13" rx="1" fill="#3DDC6E"/></g><path d="M-91 -66L-91 -40M-86 -66L-86 -40" stroke="#5A5F68" stroke-width="2.5" stroke-linecap="round"/><g transform="translate(-86 -12)"><circle cx="0.0" cy="-4.8" r="4" fill="#F59BB5" stroke="#2B1D1A" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/><circle cx="4.6" cy="-1.5" r="4" fill="#F59BB5" stroke="#2B1D1A" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/><circle cx="2.8" cy="3.9" r="4" fill="#F59BB5" stroke="#2B1D1A" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/><circle cx="-2.8" cy="3.9" r="4" fill="#F59BB5" stroke="#2B1D1A" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/><circle cx="-4.6" cy="-1.5" r="4" fill="#F59BB5" stroke="#2B1D1A" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/><circle cx="0.0" cy="-4.8" r="2.9" fill="#F59BB5"/><circle cx="4.6" cy="-1.5" r="2.9" fill="#F59BB5"/><circle cx="2.8" cy="3.9" r="2.9" fill="#F59BB5"/><circle cx="-2.8" cy="3.9" r="2.9" fill="#F59BB5"/><circle cx="-4.6