exports[`render > language cpp 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="-6 -26 236 236" role="img" aria-label="lma0/shell-pet: Adult hermit crab, happy"><title>lma0/shell-pet: Adult hermit crab, happy</title><style>.sp-bg{fill:#FAF7F2}.sp-bd{stroke:#E8DFD2}.sp-t1{fill:#2B1D1A}.sp-t2{fill:#5B4A44}@media (prefers-color-scheme:dark){.sp-bg{fill:#16202E}.sp-bd{stroke:#2A3A50}.sp-t1{fill:#E8EDF5}.sp-t2{fill:#B6C2D3}}.sp-bob{animation:sp-bob 3s ease-in-out infinite}@keyframes sp-bob{50%{transform:translateY(-3px)}}.sp-blink{transform-box:fill-box;transform-origin:center;animation:sp-blink 5s infinite}@keyframes sp-blink{0%,93%,100%{transform:scaleY(1)}96%{transform:scaleY(.1)}}.sp-jump{animation:sp-jump 1.1s ease-in-out infinite}@keyframes sp-jump{0%,100%{transform:translateY(0)}45%{transform:translateY(-16px)}}.sp-shadow{transform-box:fill-box;transform-origin:center;animation:sp-shadow 1.1s ease-in-out infinite}@keyframes sp-shadow{45%{transform:scale(.7);opacity:.5}}.sp-fall{animation:sp-fall 2.6s linear infinite}@keyframes sp-fall{0%{transform:translateY(-8px) rotate(0);opacity:0}15%{opacity:1}100%{transform:translateY(44px) rotate(160deg);opacity:0}}.sp-z{animation:sp-z 3.6s ease-in infinite}@keyframes sp-z{0%{transform:translate(0,0);opacity:0}25%{opacity:1}100%{transform:translate(10px,-22px);opacity:0}}.sp-twinkle{transform-box:fill-box;transform-origin:center;animation:sp-twinkle 2.1s ease-in-out infinite}@keyframes sp-twinkle{50%{transform:scale(.45);opacity:.45}}.sp-drift{animation:sp-drift 9s ease-in-out infinite alternate}.sp-drift2{animation:sp-drift 7s ease-in-out infinite alternate-reverse}@keyframes sp-drift{to{transform:translateX(-30px)}}.sp-cursor{animation:sp-cursor 1.1s steps(1) infinite}@keyframes sp-cursor{50%{opacity:0}}.sp-steam{animation:sp-steam 3s ease-in-out infinite}@keyframes sp-steam{0%{transform:translateY(4px);opacity:0}40%{opacity:1}100%{transform:translateY(-8px);opacity:0}}@media (prefers-reduc